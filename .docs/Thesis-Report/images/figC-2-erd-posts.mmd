---
config:
  theme: neutral
  layout: elk
---
erDiagram
    direction LR
    Post {
        Int id PK
        DateTime createdAt
        DateTime deletedAt
        Boolean isSensitive
        Boolean isApproved
        String userId FK
        Int rePostId FK
        Int parentPostId FK
        Int communityId FK
    }
    PostMedia {
        Int id PK
        Int postId FK
        DateTime createdAt
    }
    Hashtag {
        Int id PK
        String tag UK
        DateTime createdAt
    }
    PostTag {
        Int postId PK, FK
        Int hashtagId PK, FK
    }
    Like {
        Int id PK
        DateTime createdAt
        String userId FK
        Int postId FK
    }
    SavedPosts {
        Int id PK
        DateTime createdAt
        String userId FK
        Int postId FK
    }
    Report {
        Int id PK
        DateTime createdAt
        ReportStatus status
        String reporterId FK
        Int postId FK
    }
    User ||--o{ Post : "userId"
    Post |o--o{ Post : "rePostId"
    Post |o--o{ Post : "parentPostId"
    Community |o--o{ Post : "communityId"
    Post ||--o{ PostTag : "postId"
    Hashtag ||--o{ PostTag : "hashtagId"
    User ||--o{ Like : "userId"
    Post ||--o{ Like : "postId"
    User ||--o{ SavedPosts : "userId"
    Post ||--o{ SavedPosts : "postId"
    User ||--o{ Report : "reporterId"
    Post ||--o{ Report : "postId"
    Post ||--o{ PostMedia : "postId"
