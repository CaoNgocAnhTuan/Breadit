# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
apps/backend/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
apps/frontend/.next/
apps/frontend/out/

# production
/build
apps/frontend/build/
apps/backend/dist/
packages/shared/dist/
packages/ranking/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads (keep placeholder, ignore actual files)
/public/uploads/*
!/public/uploads/.gitkeep
apps/frontend/public/uploads/*
!apps/frontend/public/uploads/.gitkeep

/docs/Pre-thesis/Latex/docx/

# thesis LaTeX build files (.docs/Thesis-Report/, rebuilt with latexmk)
/.docs/Thesis-Report/*.aux
/.docs/Thesis-Report/*.log
/.docs/Thesis-Report/*.out
/.docs/Thesis-Report/*.toc
/.docs/Thesis-Report/*.lof
/.docs/Thesis-Report/*.lot
/.docs/Thesis-Report/*.fls
/.docs/Thesis-Report/*.fdb_latexmk
/.docs/Thesis-Report/*.synctex.gz
/.docs/Thesis-Report/*.bbl
/.docs/Thesis-Report/*.blg
/.docs/Thesis-Report/main.pdf
# the slides (.docs/Thesis-Report/slides/), rebuilt the same way
/.docs/Thesis-Report/slides/*.aux
/.docs/Thesis-Report/slides/*.log
/.docs/Thesis-Report/slides/*.out
/.docs/Thesis-Report/slides/*.toc
/.docs/Thesis-Report/slides/*.nav
/.docs/Thesis-Report/slides/*.snm
/.docs/Thesis-Report/slides/*.fls
/.docs/Thesis-Report/slides/*.fdb_latexmk
/.docs/Thesis-Report/slides/*.synctex.gz
/.docs/Thesis-Report/slides/*.synctex(busy)
/.docs/Thesis-Report/slides/*.pdf

# raw public datasets (downloaded by hand, recorded by SHA-256 in .docs/datasets.md)
datasets/raw/

# Claude Code harness: local state (active task, backend pid and log) and personal settings
.claude/state/*
!.claude/state/.gitkeep
.claude/settings.local.json
# Local copies of reference papers (copyrighted, not for the repo)
refs-manual/

# eval workspace: generated datasets and local modules
eval/data/
# eval results too big for git (a per_user.csv over 5 MB); the committed manifest keeps its SHA-256
eval/results/
eval/node_modules/
