{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git add *)",
      "Bash(rg *)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run build -w @breadit/shared)",
      "Bash(npm run build -w @breadit/backend)",
      "Bash(npm run test -w @breadit/backend*)",
      "Bash(npm run test:it -w @breadit/backend*)",
      "Bash(npm run test:backend)",
      "Bash(node .claude/hooks/task.cjs *)",
      "Bash(node .claude/hooks/test-hooks.cjs*)",
      "Bash(bash .claude/hooks/verify.sh*)",
      "Bash(bash .claude/hooks/run-safe.sh*)",
      "Bash(docker ps*)",
      "Bash(docker compose ps*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.cjs", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/on-prompt.cjs", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-edit.cjs", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-bash.cjs", "timeout": 10 }
        ]
      },
      {
        "matcher": "Skill|SlashCommand|ScheduleWakeup|CronCreate|SendMessage|RemoteTrigger",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-misc.cjs", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.cjs", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop.cjs", "timeout": 300, "statusMessage": "Checking backend unit tests" }
        ]
      }
    ]
  }
}
